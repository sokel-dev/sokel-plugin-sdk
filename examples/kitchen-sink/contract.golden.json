    {
      "desc": "The reserved id the platform calls from the credential page's \"Test\" button and from \"check credentials\" in a workflow. It takes no input. An unusable credential must come back as **ok=false**, not as an error — an error leaves the platform able to say only \"the call failed\", not whether the key expired or the network is down. A plugin without this operation can only discover a stale credential through a real call.",
      "id": "health_check",
      "inputs": [],
      "label": "Credential check",
      "outputs": [
        {
          "label": "Usable",
          "name": "ok",
          "required": true,
          "type": "boolean"
        },
        {
          "desc": "Say why when it is unusable; may be empty when it is fine",
          "label": "Detail",
          "name": "message",
          "type": "string"
        }
      ]
    },
    {
      "desc": "A file input, fetched lazily; a file output, handed back to the platform. Only references travel through the canvas.",
      "id": "file_digest",
      "inputs": [
        {
          "label": "File",
          "name": "file",
          "required": true,
          "type": "file"
